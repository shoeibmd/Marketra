# Marketra Financial Terminal Environment Configuration Example
# Copy this file to .env and configure environment-specific values.

# --- GENERAL & ENVIRONMENT ---
ENVIRONMENT=production
PROJECT_NAME="Open Financial Terminal Backend"
VERSION="0.1.0"
API_V1_STR="/api/v1"
APP_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost"

# --- SECURITY & AUTHENTICATION ---
# Generate a secure 32+ character random string for production: openssl rand -hex 32
SECRET_KEY="prod_secure_jwt_secret_key_change_in_production_32bytes_min"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# --- RELATIONAL DATABASE (PostgreSQL 16) ---
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=terminal_prod_user
POSTGRES_PASSWORD=prod_secure_password_min32
POSTGRES_DB=terminal_relational_prod

# --- TIME-SERIES DATABASE (TimescaleDB) ---
TIMESCALE_SERVER=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_USER=terminal_prod_user
TIMESCALE_PASSWORD=prod_secure_password_min32
TIMESCALE_DB=terminal_timeseries_prod

# --- CACHE & TASK QUEUE (Redis 7) ---
REDIS_URL=redis://redis:6379/0

# --- AI / LLM PROVIDER CONFIGURATION ---
AI_PROVIDER_TYPE=mock  # Options: mock, openai, ollama
AI_MODEL_NAME=mock-financial-rag-v1
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- MARKET DATA & NEWS INGESTION ---
MARKET_DATA_PROVIDER=mock  # Options: mock, zerodha, upstox
NEWS_FETCH_INTERVAL_MINUTES=5
MAX_WEBSOCKET_CONNECTIONS=100
